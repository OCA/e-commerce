<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="choose_delivery_carrier_view_form_inherit" model="ir.ui.view">
        <field name="name">choose.delivery.carrier.form.inherit</field>
        <field name="inherit_id" ref="delivery.choose_delivery_carrier_view_form" />
        <field name="model">choose.delivery.carrier</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='update_price']" position="attributes">
                <attribute
                    name="invisible"
                >delivery_type in ('fixed', 'base_on_rule', 'saleor')</attribute>
            </xpath>
            <xpath expr="//field[@name='invoicing_message']/.." position="after">
                <div
                    class="alert alert-warning"
                    role="status"
                    invisible="delivery_type != 'saleor' or saleor_warning_msg == ''"
                >
                    <field name="saleor_warning_msg" nolabel="1" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
