<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_warehouse_form_inherit_saleor" model="ir.ui.view">
        <field name="name">stock.warehouse</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="action_sync_to_saleor_warehouse"
                        type="object"
                        string="Sync to Saleor"
                        class="oe_highlight"
                        icon="fa-refresh"
                    />
                    <button
                        name="action_sync_product_quantities"
                        type="object"
                        string="Sync Product Quantities"
                        icon="fa-dropbox"
                    />
                </header>
            </xpath>

            <xpath expr="//field[@name='partner_id']/.." position="after">
                <group string="Saleor" name="saleor">
                    <group>
                        <field name="is_saleor_warehouse" />
                        <field name="include_in_saleor_inventory" />
                    </group>
                    <group>
                        <field name="is_private" widget="radio" />
                        <field
                            name="saleor_warehouse_id"
                            groups="sale_saleor.group_saleor_manager"
                            attrs="{'invisible': [('is_saleor_warehouse', '=', False)]}"
                        />
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_warehouse_tree_inherit_saleor" model="ir.ui.view">
        <field name="name">stock.warehouse.tree</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="before">
                <header>
                    <button
                        name="action_sync_to_saleor_warehouse"
                        type="object"
                        string="Sync to Saleor"
                        icon="fa-refresh"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
