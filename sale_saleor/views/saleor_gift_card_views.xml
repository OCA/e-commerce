<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_saleor_giftcard_tree" model="ir.ui.view">
        <field name="name">saleor.giftcard.tree</field>
        <field name="model">saleor.giftcard</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button
                        name="action_activate_giftcard"
                        type="object"
                        string="Active Gift Cards"
                        icon="fa-refresh"
                        groups="sale_saleor.group_saleor_manager"
                    />
                </header>
                <field name="name" />
                <field name="code" />
                <field name="status" />
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_saleor_giftcard_form" model="ir.ui.view">
        <field name="name">saleor.giftcard.form</field>
        <field name="model">saleor.giftcard</field>
        <field name="arch" type="xml">
            <form string="Gift Card">
                <header>
                    <button
                        name="action_activate_giftcard"
                        string="Activate"
                        type="object"
                        class="oe_highlight"
                        groups="sale_saleor.group_saleor_manager"
                        invisible="status != 'disabled'"
                    />
                    <button
                        name="action_deactivate_giftcard"
                        string="Deactivate"
                        type="object"
                        class="oe_highlight"
                        groups="sale_saleor.group_saleor_manager"
                        invisible="status != 'active'"
                    />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="amount" />
                        </group>
                        <group>
                            <field
                                name="currency_id"
                                domain="[('id','in', available_currency_ids)]"
                                nolabel="1"
                            />
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" />
                        <field name="send_to_customer" />
                        <field name="partner_id" invisible="not send_to_customer" />
                        <field name="channel_id" invisible="not send_to_customer" />
                        <field name="set_expiry_date" />
                        <field
                            name="expiry_type"
                            invisible="not set_expiry_date"
                            widget="radio"
                            nolabel="1"
                        />
                    </group>
                    <group>
                        <group>
                            <label
                                for="expiry_duration"
                                string="Expiry Duration"
                                invisible="not set_expiry_date or expiry_type != 'duration'"
                            />
                            <div class="o_row">
                                <field
                                    name="expiry_duration"
                                    invisible="not set_expiry_date or expiry_type != 'duration'"
                                />
                                <field
                                    name="expiry_unit"
                                    invisible="not set_expiry_date or expiry_type != 'duration'"
                                    nolabel="1"
                                />
                            </div>
                        </group>
                        <group>
                            <field
                                string="Will expire on"
                                name="expiry_date"
                                invisible="not set_expiry_date or expiry_type != 'duration'"
                            />
                        </group>
                    </group>
                    <group>
                        <field
                            string="Exact date"
                            name="expiry_date"
                            invisible="not set_expiry_date or expiry_type != 'exact'"
                        />
                    </group>
                    <group>
                        <field name="note" />
                        <field name="requires_activation" />
                    </group>
                    <group string="Metadata" colspan="2">
                        <field name="saleor_metadata_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                    <group string="Private Metadata" colspan="2">
                        <field name="saleor_private_metadata_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_saleor_giftcard" model="ir.actions.act_window">
        <field name="name">Gift Cards</field>
        <field name="res_model">saleor.giftcard</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_saleor_giftcard_tree" />
    </record>
</odoo>
