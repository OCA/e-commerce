<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_delivery_carrier_form_inherit_saleor" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.saleor</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <button name="toggle_prod_environment" icon="fa-stop" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|','|','|',
                        ('prod_environment', '=', True),
                        ('delivery_type', '=', 'fixed'),
                        ('delivery_type', '=', 'base_on_rule'),
                        ('delivery_type', '=', 'saleor')
                    ]}
                </attribute>
            </button>
            <button name="toggle_debug" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', 'in', ('fixed','base_on_rule','saleor'))]}
                </attribute>
            </button>
            <field name="integration_level" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', 'in', ('fixed','base_on_rule','saleor'))]}
                </attribute>
            </field>
            <field name="margin" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </field>
            <xpath expr="//label[@for='margin']/.." position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <!-- <field name="fixed_margin" position="attributes">
                <attribute
                    name="invisible"
                >delivery_type == 'fixed' or delivery_type == 'saleor'</attribute>
            </field> -->
            <!-- <label for="free_over" position="attributes">
                <attribute
                    name="invisible"
                >delivery_type == 'base_on_rule' or delivery_type == 'saleor'</attribute>
            </label> -->
            <field name="free_over" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </field>
            <field name="product_id" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </field>

            <xpath expr="(//field[@name='company_id'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="invoice_policy" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </field>
            <page name="destination" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </page>
            <page name="description" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('delivery_type', '=', 'saleor')]}
                </attribute>
            </page>

            <xpath expr="//page[@name='description']" position="after">
                <page
                    name="saleor"
                    string="Saleor"
                    attrs="{'invisible': [('delivery_type', '!=', 'saleor')]}"
                >
                    <group>
                        <field name="zone_channel_ids" invisible="1" />
                        <field
                            name="saleor_shipping_method_id"
                            groups="sale_saleor.group_saleor_manager"
                            attrs="{'invisible': [('delivery_type', '!=', 'saleor')]}"
                        />
                    </group>
                    <group>
                        <group>
                            <field name="shipping_method_type" />
                            <field name="tax_id" />
                        </group>
                        <group>
                            <field name="min_delivery_time" />
                            <field name="max_delivery_time" />
                        </group>
                    </group>
                    <label for="description" />
                    <div>
                        <field name="description" type="html" />
                    </div>
                    <group>
                        <field name="order_value" />
                        <field
                            name="saleor_order_value_line_ids"
                            nolabel="1"
                            attrs="{'invisible': [('order_value', '=', False)]}"
                            colspan="2"
                        >
                            <tree editable="bottom">
                                <field
                                    name="channel_id"
                                    string="Channel name"
                                    domain="[('id','in', parent.zone_channel_ids)]"
                                    options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                />
                                <field name="min_value" />
                                <field name="display_unit" nolabel="1" />
                                <field name="max_value" />
                                <field name="display_unit" nolabel="1" />
                            </tree>
                        </field>
                    </group>
                    <group string="Pricing" colspan="2">
                        <field
                            name="saleor_shipping_pricing_line_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree editable="bottom">
                                <field
                                    name="channel_id"
                                    string="Channel name"
                                    domain="[('id','in', parent.zone_channel_ids)]"
                                    options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                />
                                <field name="price" />
                                <field name="currency_id" nolabel="1" />
                            </tree>
                        </field>
                    </group>
                    <group string="Postal Codes" colspan="2">
                        <group>
                            <field
                                name="postal_filter_mode"
                                widget="radio"
                                options="{'horizontal': True}"
                            />
                        </group>
                        <field name="postal_code_range_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="start_zip" />
                                <field name="end_zip" />
                            </tree>
                        </field>
                    </group>
                    <group string="Excluded Products" colspan="2">
                        <field name="excluded_product_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="name" />
                            </tree>
                        </field>
                    </group>
                    <group string="Metadata">
                        <field
                            name="shipping_method_metadata_line_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                    <group string="Private Metadata">
                        <field
                            name="shipping_method_private_metadata_line_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
