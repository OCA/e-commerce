<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="loyalty_program_view_form_inherit_saleor" model="ir.ui.view">
        <field name="name">loyalty.program.view.form.inherit.saleor</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form" />
        <field name="arch" type="xml">
            <button name="action_open_loyalty_cards" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </button>
            <field name="date_to" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </field>
            <xpath expr="//label[@for='limit_usage']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//span[field[@name='limit_usage']]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='portal_point_name'][1]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', 'in', ('loyalty', 'gift_card', 'ewallet', 'saleor'))]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='portal_point_name'][2]" position="attributes">
                <attribute name="attrs">
                    {'invisible': ['|',
                        ('program_type', 'in', ('gift_card', 'ewallet', 'saleor')),
                        ('program_type', '!=', 'loyalty')
                    ]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='company_id'][2]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='portal_visible'][2]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', 'in', ('gift_card', 'ewallet', 'saleor'))]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='trigger'][2]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//label[@for='available_on']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='sale_ok']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//label[@for='sale_ok']" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <xpath expr="//field[@name='applies_on'][2]" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', '=', 'saleor')]}
                </attribute>
            </xpath>
            <page name="rules_rewards" position="attributes">
                <attribute name="attrs">
                    {'invisible': [('program_type', 'in', ('gift_card', 'ewallet', 'saleor'))]}
                </attribute>
            </page>
            <xpath expr="//button[@name='action_open_loyalty_cards']" position="after">
                <button
                    name="action_saleor_sync"
                    type="object"
                    string="Sync to Saleor"
                    class="oe_highlight"
                    icon="fa-refresh"
                    groups="sale_saleor.group_saleor_manager"
                    attrs="{'invisible': [('program_type', '!=', 'saleor')]}"
                />
            </xpath>

            <xpath expr="//page[@name='rules_rewards']" position="after">
                <page
                    name="saleor"
                    string="Saleor"
                    attrs="{'invisible': [('program_type', '!=', 'saleor')]}"
                >
                    <group>
                        <field
                            name="saleor_promotion_id"
                            groups="sale_saleor.group_saleor_manager"
                        />
                        <field name="discount_type" />
                        <field name="saleor_description" />
                    </group>
                    <group>
                        <field name="active_date_from" />
                        <field name="set_end_date" />
                        <field
                            name="active_date_to"
                            attrs="{'invisible': [('set_end_date', '=', False)]}"
                        />
                    </group>
                    <group>
                        <field
                            name="discount_rule_ids"
                            mode="kanban"
                            nolabel="1"
                            add-label="Add a rule"
                            class="o_loyalty_kanban_inline"
                            widget="loyalty_one2many"
                        />
                    </group>
                </page>
            </xpath>
            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" />
                    <field name="message_ids" widget="mail_thread" />
                    <field name="activity_ids" widget="mail_activity" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
