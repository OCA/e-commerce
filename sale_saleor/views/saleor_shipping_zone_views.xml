<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_saleor_shipping_zone_tree" model="ir.ui.view">
        <field name="name">saleor.shipping.zone.tree</field>
        <field name="model">saleor.shipping.zone</field>
        <field name="arch" type="xml">
            <list string="Shipping Zones">
                <header>
                    <button
                        name="action_saleor_shipping_zone_sync"
                        type="object"
                        string="Sync to Saleor"
                        icon="fa-refresh"
                        groups="sale_saleor.group_saleor_manager"
                    />
                </header>
                <field name="name" />
                <field name="description" />
                <field name="country_ids" widget="many2many_tags" />
                <field name="channel_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_saleor_shipping_zone_form" model="ir.ui.view">
        <field name="name">saleor.shipping.zone.form</field>
        <field name="model">saleor.shipping.zone</field>
        <field name="arch" type="xml">
            <form string="Shipping Zone">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_saleor_shipping_zone_sync"
                            type="object"
                            string="Sync to Saleor"
                            icon="fa-refresh"
                        />
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Shipping Zone name" />
                        <h1>
                            <field name="name" placeholder="Default Shipping Zone" />
                        </h1>
                    </div>
                    <group>
                        <field name="saleor_id" invisible="1" />
                        <field
                            name="description"
                            placeholder="Description of a shipping zone"
                        />
                    </group>
                    <group>
                        <group string="Countries &amp; Channels">
                            <field name="country_ids" widget="many2many_tags" />
                            <field
                                name="channel_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="shipping_method_ids"
                                widget="many2many_tags"
                                domain="[('delivery_type', '=', 'saleor')]"
                            />
                        </group>
                        <group string="Warehouse">
                            <field
                                name="warehouse_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                            <field
                                name="location_ids"
                                widget="many2many_tags"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                    </group>
                    <group string="Metadata" colspan="2">
                        <field name="shipping_zone_metadata_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                    <group string="Private Metadata" colspan="2">
                        <field
                            name="shipping_zone_private_metadata_line_ids"
                            nolabel="1"
                        >
                            <list editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_saleor_shipping_zone" model="ir.actions.act_window">
        <field name="name">Shipping Zones</field>
        <field name="res_model">saleor.shipping.zone</field>
        <field name="view_mode">list,form</field>
        <field
            name="help"
        >Define Saleor Shipping Zones, assign countries, channels, warehouses/locations and shipping methods.</field>
    </record>
</odoo>
