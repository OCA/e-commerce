<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend account.tax form to add Saleor metadata fields -->
    <record id="view_account_tax_form_inherit_saleor" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.saleor</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//form/sheet/group/group/field[@name='name']/../.."
                position="before"
            >
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_saleor_tax_sync"
                        type="object"
                        string="Sync to Saleor"
                        class="oe_highlight"
                        icon="fa-refresh"
                        groups="sale_saleor.group_saleor_manager"
                        attrs="{'invisible': ['|', ('amount_type', '!=', 'percent'), ('type_tax_use', '!=', 'sale')]}"
                    />
                </div>
            </xpath>
            <xpath expr="//page[@name='advanced_options']" position="after">
                <page
                    string="Saleor"
                    attrs="{'invisible': ['|', ('amount_type', '!=', 'percent'), ('type_tax_use', '!=', 'sale')]}"
                >
                    <group string="Metadata">
                        <field name="saleor_metadata_line_ids" nolabel="1" colspan="2">
                            <tree editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                    <group string="Private Metadata">
                        <field
                            name="saleor_private_metadata_line_ids"
                            nolabel="1"
                            colspan="2"
                        >
                            <tree editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </tree>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_tax_tree_inherit_saleor" model="ir.ui.view">
        <field name="name">account.tax.tree.inherit.saleor</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="before">
                <header>
                    <button
                        name="action_saleor_tax_sync"
                        type="object"
                        string="Sync to Saleor"
                        icon="fa-refresh"
                        groups="sale_saleor.group_saleor_manager"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
