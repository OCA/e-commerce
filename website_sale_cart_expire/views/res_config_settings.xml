<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="abandoned_carts_setting" position="after">
                <setting
                    id="cart_expire_setting"
                    string="Expire Carts"
                    help="Automatically cancel carts without activity after a period of time."
                    company_specific="1"
                >
                    <div class="content-group">
                        <div class="row mt16">
                            <div class="col-12">
                                <label
                                string="Cart is cancelled after"
                                for="cart_expire_delay"
                                class="o_light_label"
                            />
                                <field
                                name="cart_expire_delay"
                                widget="float_time"
                                class="ms-1"
                                style="width: 50px;"
                            /> hours.
                            </div>
                        </div>
                    </div>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
