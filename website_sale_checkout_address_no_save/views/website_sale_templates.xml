<odoo>
    <template id="archive_address">
        <div class="col-lg-12 mb-2">
            <input
                type="checkbox"
                name="archive_address"
                id="archive_address"
                checked="true"
            />
            <label for="archive_address" class="control-label form-check-label">
                This address will be archive after checkout
            </label>
        </div>
    </template>
    <template
        id="archive_address_dropshipping"
        inherit_id="website_sale.address"
        name="Archive Address after checkout"
        customize_show="True"
        active="False"
    >
        <xpath expr="//form/div[hasclass('row')]" position="inside">
            <div
                class="col-lg-12"
                t-if="address_type == 'delivery' and not is_anonymous_cart and partner_id != website_sale_order.partner_id.id"
            >
                <t t-call="website_sale_checkout_address_no_save.archive_address" />
            </div>
        </xpath>
    </template>
</odoo>
