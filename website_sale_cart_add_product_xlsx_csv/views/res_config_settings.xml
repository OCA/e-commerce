<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="website_shop_checkout" position="inside">
                <setting
                    id="cart_import_button_setting"
                    string="Cart Import Button"
                    help="Enable or disable the cart import button"
                >
                    <field name="cart_import_button" />
                </setting>
                <setting
                    id="cart_import_button_file_limit_setting"
                    string="Cart Import Button File Size Limit (MB)"
                    invisible="not cart_import_button"
                >
                    <field name="cart_import_button_file_limit" />
                </setting>
            </block>
        </field>
    </record>
</odoo>
