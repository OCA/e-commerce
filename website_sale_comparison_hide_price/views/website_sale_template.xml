<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="compare_page_hide_price"
        inherit_id="website_sale_comparison.product_compare"
    >
        <xpath expr="//span[del[contains(@t-out,'list_price')]]" position="before">
            <t t-set="user_authenticated" t-value="user_id != website.user_id" />
            <div
                class="alert alert-info"
                t-if="product.website_hide_price and (product.website_hide_price_message or website.website_hide_price_default_message) and user_authenticated"
            >
                <i class="fa fa-info-circle" />
                <span
                    t-out="product.website_hide_price_message or website.website_hide_price_default_message"
                />
            </div>
        </xpath>
        <xpath expr="//span[del[contains(@t-out,'list_price')]]" position="attributes">
            <attribute name="t-if">
                not combination_info['prevent_zero_price_sale'] and website.website_show_price and not product.website_hide_price
            </attribute>
        </xpath>
        <xpath
            expr="//div[button[@name='comparison_add_to_cart']]"
            position="attributes"
        >
            <attribute name="t-if">
                website.website_show_price and not product.website_hide_price
            </attribute>
        </xpath>
    </template>
</odoo>
