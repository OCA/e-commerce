<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
        id="product_eprel_label"
        inherit_id="website_sale.product"
        customize_show="True"
        name="EPREL: Energy Label in Product Page"
    >
    <xpath expr="//div[@id='product_details']" position="inside">
      <t t-if="product and product.label_arrow_url">
        <div class="mt-2 d-flex align-items-center" style="gap: 1rem;">
          <a t-if="product.label_url" t-att-href="product.label_url" target="_blank">
            <img
                            t-att-src="product.label_arrow_url"
                            alt="Energy Efficiency Label"
                            style="width: 80px; height: auto;"
                        />
          </a>
          <t t-if="product.fiche_url">
            <a t-att-href="product.fiche_url" target="_blank">
              Product Information Sheet
            </a>
          </t>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
