<odoo>
    <record id="product_template_public_rule" model="ir.rule">
        <field name="name">Product Template: Public User: published only</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]" />
    </record>
    <record id="product_template_portal_rule" model="ir.rule">
        <field name="name">Product Template: Portal User: published only</field>
        <field name="model_id" ref="product.model_product_template" />
        <field name="domain_force">[('is_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
    </record>
</odoo>
