<odoo>
    <template
        id="hide_categories_recursive"
        inherit_id="website_sale.categories_recursive"
        name="Hide Empty Category list"
    >
        <xpath
            expr="//t[@t-name='website_sale.categories_recursive']"
            position="attributes"
        >
            <attribute
                name="t-if"
            >not hide_empty_category or c.has_published_products</attribute>
        </xpath>
    </template>
    <template
        id="hide_categories_snippet_recursive"
        inherit_id="website_sale.dynamic_filter_template_product_public_category_default"
        name="Hide Empty Category Snippet list"
    >
        <xpath expr="//div[@name='category_item']" position="attributes">
            <attribute
                name="t-if"
            >(not is_parent or includeParent) and not category.get('unpublished')</attribute>
        </xpath>
    </template>
    <template
        id="hide_categories_collapse_recursive"
        inherit_id="website_sale.option_collapse_categories_recursive"
        name="Hide Empty Category Collapsible list"
    >
        <xpath expr="//t[@t-if='children']" position="attributes">
            <attribute
                name="t-if"
            >children and (not hide_empty_category or c.has_published_products)</attribute>
        </xpath>
        <xpath expr="//li[@t-else='']" position="attributes">
            <attribute name="t-else" />
            <attribute
                name="t-if"
            >not children and (not hide_empty_category or c.has_published_products)</attribute>
        </xpath>
    </template>
    <template
        id="hide_categories_recursive_helper"
        inherit_id="website_sale.products_categories_list"
        name="Hide Empty Category list"
        customize_show="True"
        active="True"
    >
        <xpath expr="//t[@t-foreach='categories']" position="before">
            <t t-set="hide_empty_category" t-value="True" />
        </xpath>
    </template>
    <template
        id="hide_filmstrip_categories"
        inherit_id="website_sale.filmstrip_categories"
        name="Hide Empty Category Filmstrip"
        customize_show="True"
        active="True"
    >
        <xpath expr="//div[@id='o_wsale_categories_filmstrip']" position="before">
            <t t-set="hide_empty_category" t-value="True" />
        </xpath>
        <xpath expr="//li[@t-foreach='entries']" position="attributes">
            <attribute
                name="t-if"
            >not hide_empty_category or c.has_published_products</attribute>
        </xpath>
    </template>
</odoo>
