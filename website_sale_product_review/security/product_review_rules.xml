<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_review_own_portal_rule" model="ir.rule">
        <field name="name">Portal Users: Own Product Reviews Only</field>
        <field name="model_id" ref="model_product_review" />
        <field name="groups" eval="[(4, ref('base.group_portal'))]" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="product_review_own_internal_rule" model="ir.rule">
        <field name="name">Internal Users: Own Product Reviews Only</field>
        <field name="model_id" ref="model_product_review" />
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="product_review_admin_rule" model="ir.rule">
        <field name="name">Admin Full Access</field>
        <field name="model_id" ref="model_product_review" />
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
