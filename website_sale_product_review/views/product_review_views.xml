<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_review_tree" model="ir.ui.view">
        <field name="name">product.review.list</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id" />
                <field name="rating" />
                <field name="comment" />
            </list>
        </field>
    </record>

    <record id="view_product_review_form" model="ir.ui.view">
        <field name="name">product.review.form</field>
        <field name="model">product.review</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="product_id" />
                    <field name="rating" />
                    <field name="comment" />
                    <field name="partner_id" readonly="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="product_review_action" model="ir.actions.act_window">
        <field name="name">Product Reviews</field>
        <field name="res_model">product.review</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('product_id', '=', active_id)]</field>
        <field name="context">{'default_product_id': active_id}</field>
    </record>
</odoo>
