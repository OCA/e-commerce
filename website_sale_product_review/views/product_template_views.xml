<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_reviews" model="ir.ui.view">
        <field name="name">product.template.form.inherit.review</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="%(product_review_action)d"
                    type="action"
                    class="oe_stat_button"
                    icon="fa-star"
                >
                    <field name="review_count" widget="statinfo" string="Reviews" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
