<data>
    <template
        id="sale_order_portal_content_inherit_website_sale_digital"
        inherit_id="website_sale_digital.sale_order_portal_content_inherit_website_sale_digital"
    >
        <xpath
            expr="//t[@t-foreach='attachments']//a[@role='menuitem']"
            position="attributes"
