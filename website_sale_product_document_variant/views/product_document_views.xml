<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_document_form" model="ir.ui.view">
        <field name="model">product.document</field>
        <field name="inherit_id" ref="website_sale.product_document_form" />
        <field name="arch" type="xml">
            <group name="website_sale" position="attributes">
                <attribute name="invisible">0</attribute>
            </group>
        </field>
    </record>

    <record id="product_document_kanban" model="ir.ui.view">
        <field name="model">product.document</field>
        <field name="inherit_id" ref="website_sale.product_document_kanban" />
        <field name="arch" type="xml">
            <xpath
                expr="//div[@invisible=&quot;res_model == 'product.product'&quot;]"
                position="attributes"
            >
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_document_list" model="ir.ui.view">
        <field name="model">product.document</field>
        <field name="inherit_id" ref="website_sale.product_document_list" />
        <field name="arch" type="xml">
            <field name="shown_on_product_page" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
        </field>
    </record>
</odoo>
