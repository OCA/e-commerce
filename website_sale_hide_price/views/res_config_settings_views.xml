<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <setting id="hide_add_to_cart_setting" position="after">
                <setting
                    id="website_sale_hide_price"
                    help="Hide prices at website level"
                >
                    <field name="website_hide_price" />
                </setting>
                <setting
                    id="website_sale_hide_price_message"
                    help="Set a default text when hiding prices"
                >
                    <field name="website_hide_price_default_message" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
