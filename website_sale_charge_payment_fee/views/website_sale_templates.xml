<odoo>

    <template
        id="token_form"
        name="website_sale_charge_payment_fee_token_form"
        inherit_id="payment.token_form"
    >
        <xpath expr="//input[@name='o_payment_radio']" position="attributes">
            <attribute name="t-att-data-is-fee">provider_sudo.charge_fee</attribute>
        </xpath>
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <t t-if="provider_sudo.charge_fee">
                <span class="badge rounded-pill text-bg-secondary ms-1"> + <t
                        t-if="provider_sudo.charge_fee_type == 'fixed'"
                    >
                        <span
                            id="charge_fee_fixed_price"
                            t-field="provider_sudo.charge_fee_fixed_price"
                            t-options="{'widget': 'monetary', 'display_currency': provider_sudo.charge_fee_currency_id}"
                        />
                    </t>
                    <t t-if="provider_sudo.charge_fee_type == 'percentage'">
                        <span
                            id="charge_fee_percentage"
                            t-field="provider_sudo.charge_fee_percentage"
                        />% </t> Fee </span>
            </t>
        </xpath>
    </template>

    <template id="checkout" inherit_id="payment.method_form">
        <xpath expr="//input[@name='o_payment_radio']" position="attributes">
            <attribute name="t-att-data-is-fee">provider_sudo.charge_fee</attribute>
        </xpath>
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <t t-if="provider_sudo.charge_fee">
                <span class="badge rounded-pill text-bg-secondary ms-1"> + <t
                        t-if="provider_sudo.charge_fee_type == 'fixed'"
                    >
                        <span
                            id="charge_fee_fixed_price"
                            t-field="provider_sudo.charge_fee_fixed_price"
                            t-options="{'widget': 'monetary', 'display_currency': provider_sudo.charge_fee_currency_id}"
                        />
                    </t>
                    <t t-if="provider_sudo.charge_fee_type == 'percentage'">
                        <span
                            id="charge_fee_percentage"
                            t-field="provider_sudo.charge_fee_percentage"
                        />% </t> Fee </span>
            </t>
        </xpath>
    </template>

    <template id="express_checkout" inherit_id="payment.express_checkout">
        <xpath
            expr="//form[@name='o_payment_express_checkout_form']"
            position="attributes"
        >
            <attribute
                name="t-attf-data-is-fee"
            >{{ providers_sudo[:1].charge_fee if providers_sudo else '' }}</attribute>
        </xpath>
    </template>

    <template id="total" name="Payment Fee" inherit_id="website_sale.total">
        <xpath expr="//tr[@id='order_total_untaxed']" position="before">
            <tr
                id="order_payment_fee"
                t-attf-class="{{ 'd-none' if not website_sale_order.amount_payment_fee else '' }}"
            >
                <td
                    id="payment_fee"
                    class="border-0 pb-2 ps-0 pt-0 text-start text-muted"
                    colspan="2"
                >
                    Payment Fee
                </td>
                <td class="text-end border-0 pb-2 pe-0 pt-0">
                    <span
                        t-field="website_sale_order.amount_payment_fee"
                        class="monetary_field"
                        style="white-space: nowrap;"
                        t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"
                    />
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
