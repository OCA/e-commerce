<?xml version="1.0" ?>
<odoo>

    <template id="checkout" inherit_id="payment.checkout">
        <xpath expr="//span[hasclass('payment_option_name')]" position="after">
            <t t-if="provider.charge_fee">
                <span class="badge rounded-pill text-bg-secondary ms-1">
                    +
                    <t t-if="provider.charge_fee_type == 'fixed'">
                        <span
                            id="charge_fee_fixed_price"
                            t-field="provider.charge_fee_fixed_price"
                            t-options="{'widget': 'monetary', 'display_currency': provider.charge_fee_currency_id}"
                        />
                    </t>
                    <t t-if="provider.charge_fee_type == 'percentage'">
                        <span
                            id="charge_fee_percentage"
                            t-field="provider.charge_fee_percentage"
                        />%
                    </t>
                    Fee
                </span>
            </t>
        </xpath>
    </template>
    <template id="total" name="Payment Fee" inherit_id="website_sale.total">
        <xpath expr="//tr[@id='order_total_untaxed']" position="before">
            <tr id="order_payment_fee" t-if="website_sale_order.amount_payment_fee">
                <td class="text-end border-0">Payment Fee:</td>
                <td class="text-end border-0">
                    <span
                        t-field="website_sale_order.amount_payment_fee"
                        class="monetary_field"
                        style="white-space: nowrap;"
                        t-options="{'widget': 'monetary', 'display_currency': website_sale_order.currency_id}"
                    />
                </td>
            </tr>
        </xpath>
    </template>
</odoo>
