<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="form" inherit_id="payment.form">
        <form position="before">
            <t
                t-set="payment_term_id"
                t-value="env['sale.order'].get_payment_term_by_order_id(sale_order_id)"
            />
            <t t-if="not payment_term_id">
                <t
                    t-set="providers_sudo"
                    t-value="list(filter(lambda acq: not acq.display_main_payment_term, providers_sudo))"
                />
            </t>
        </form>
    </template>

    <template id="token_form" inherit_id="payment.token_form">
        <xpath expr="//input[@name='o_payment_radio']/.." position="inside">
            <div
                t-if="provider_sudo.display_main_payment_term and payment_term_id"
                t-esc="payment_term_id.display_name"
            />
        </xpath>
    </template>

    <template id="method_form" inherit_id="payment.method_form">
        <xpath expr="//div[hasclass('form-check')]" position="inside">
            <div
                t-if="provider_sudo.display_main_payment_term and payment_term_id"
                t-esc="payment_term_id.display_name"
            />
        </xpath>
    </template>
</odoo>
