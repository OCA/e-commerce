<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="form" inherit_id="payment.form">
        <div id="o_payment_form_options" position="before">
            <t
                t-set="payment_term_id"
                t-value="env['sale.order'].get_payment_term_by_order_id(sale_order_id)"
            />
        </div>
        <xpath
            expr="//div[@id='o_payment_methods']//li[@name='o_payment_option']"
            position="attributes"
        >
            <attribute
                name="t-foreach"
            >pm_sudo.provider_ids.filtered(lambda p: p in providers_sudo and (payment_term_id or not p.display_main_payment_term))</attribute>
            <attribute name="t-as">provider_sudo</attribute>
        </xpath>
    </template>

    <template id="method_form" inherit_id="payment.method_form">
        <!-- we're already passing provider_sudo from payment.form above -->
        <t t-set="provider_sudo" position="attributes">
            <attribute name="t-value">provider_sudo</attribute>
        </t>
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="before">
            <t t-if="provider_sudo.display_main_payment_term and payment_term_id">
                <t t-set="label_name" t-value="payment_term_id.display_name" />
            </t>
            <t t-elif="provider_sudo.payment_term_id">
                <t
                    t-set="label_name"
                    t-value="provider_sudo.payment_term_id.display_name"
                />
            </t>
            <t t-else="">
                <t t-set="label_name" t-value="pm_sudo.name" />
            </t>
        </xpath>
        <input name="o_payment_radio" position="attributes">
            <attribute name="t-attf-id">
                o_payment_method_{{pm_sudo.id}}_provider_{{provider_sudo.id}}
            </attribute>
        </input>
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="attributes">
            <attribute name="t-out">label_name</attribute>
            <attribute name="t-attf-for">
                o_payment_method_{{pm_sudo.id}}_provider_{{provider_sudo.id}}
            </attribute>

            <div
                t-if="provider_sudo.display_main_payment_term and payment_term_id"
                t-esc="payment_term_id.display_name"
            />
            <div
                t-elif="provider_sudo.payment_term_id"
                t-esc="provider_sudo.payment_term_id.display_name"
            />
        </xpath>
    </template>
</odoo>
