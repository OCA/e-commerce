<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.form.inherit.website_sale_product_assurance_icons</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//setting[@id='website_tax_inclusion_setting']"
                position="after"
            >
                <setting
                    string="Assurance Icons Columns"
                    id="assurance_columns_setting"
                    help="Number of columns used to display the assurance icons block on product pages."
                >
                    <field
                        name="assurance_columns"
                        widget="radio"
                        class="o_light_label"
                    />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
