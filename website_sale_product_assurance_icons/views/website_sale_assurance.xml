<odoo>
    <record id="website_sale_assurance_view_list" model="ir.ui.view">
        <field name="name">website.sale.assurance.list</field>
        <field name="model">website.sale.assurance</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="sequence" />
                <field name="image" widget="image" />
                <field name="icon" />
                <field name="name" />
                <field name="subtitle" />
                <field name="url" />
                <field name="website_id" />
            </list>
        </field>
    </record>

    <record id="website_sale_assurance_view_form" model="ir.ui.view">
        <field name="name">website.sale.assurance.form</field>
        <field name="model">website.sale.assurance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="image" widget="image" />
                            <field name="icon" />
                            <field name="subtitle" />
                            <field name="url" />
                        </group>
                        <group>
                            <field name="website_id" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="website_sale_assurance_action" model="ir.actions.act_window">
        <field name="name">Assurance Icons</field>
        <field name="res_model">website.sale.assurance</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="website_sale_assurance_view_list" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure the assurance icons shown on product pages.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_website_sale_assurance"
        name="Assurance Icons"
        parent="website_sale.menu_ecommerce_settings"
        action="website_sale_assurance_action"
        sequence="160"
    />
</odoo>
