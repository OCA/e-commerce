<odoo>

    <template
        id="products_item"
        inherit_id="website_sale.products_item"
        priority="9999"
    >
        <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="attributes">
            <attribute name="t-if">product.website_btn_addtocart_published</attribute>
        </xpath>
    </template>

    <template id="product" inherit_id="website_sale.product" priority="9999">
        <!--
            we want to hide the o_wsale_cta_wrapper div (to also remove the
            quantity buttons), but it must still exist, because the
            website_sale_stock module expects it to be there. so, instead of
            removing it completely by setting the t-if attribute on it
            directly, we wrap it or add it empty.
        -->
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="replace">
            <t t-if="product.website_btn_addtocart_published">$0</t>
            <t t-else=""><div
                    id="o_wsale_cta_wrapper"
                    class="d-flex flex-wrap align-items-center"
                /></t>
        </xpath>
    </template>

</odoo>
