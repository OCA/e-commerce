<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Delivery Method Form View -->
    <record id="view_delivery_carrier_form_inherit_delivery_date" model="ir.ui.view">
        <field name="name">delivery.carrier.form.inherit.delivery.date</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='destination']" position="inside">
                <group>
                    <group string="Minimum Delivery Delay">
                        <field name="min_delivery_delay_type" />
                        <field name="min_delivery_delay" />
                    </group>
                </group>
                <field name="weekday_rule_ids">
                    <list editable="bottom">
                        <field name="weekday" />
                        <field name="active" />
                        <field name="delivery_start_hour" />
                        <field name="delivery_end_hour" />
                        <field name="cutoff_hour" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
