<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="payment_provider_form_sequra" model="ir.ui.view">
        <field name="name">payment.provider.form.sequra</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group
                    name="sequra_credentials"
                    string="SeQura Widget Configuration"
                    invisible="code != 'sequra'"
                >
                    <field name="sequra_asset_key" password="True" />
                    <field name="sequra_script_uri" readonly="1" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
