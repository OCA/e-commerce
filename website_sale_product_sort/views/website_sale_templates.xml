<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="products"
        active="True"
        customize_show="True"
        inherit_id="website_sale.products"
        name="Extend Sort by"
        priority="9999"
    >
        <xpath expr="//t[@t-set='website_sale_sortable']" position="attributes">
            <attribute name="t-value">website._get_product_sort_criterias()</attribute>
        </xpath>
    </template>

    <template id="sort" inherit_id="website_sale.sort" priority="9999">
        <xpath expr="//t[@t-set='_current_sort']" position="attributes">
            <attribute
                name="t-value"
            >isSortingBy and isSortingBy[0][0] or (is_view_active('website_sale_product_sort.products') and website.default_product_sort_criteria) or website.shop_default_sort</attribute>
        </xpath>
        <xpath
            expr="//span[@t-else='' and @t-out='dict(website_sale_sortable)[website.shop_default_sort]']"
            position="replace"
        >
            <t t-else="1">
                <t
                    t-if="is_view_active('website_sale_product_sort.products') and website.default_product_sort_criteria"
                >
                    <span
                        t-out="dict(website._get_product_sort_criterias()).get(website.default_product_sort_criteria, website.default_product_sort_criteria)"
                    />
                </t>
                <t t-else="">
                    <span
                        t-out="dict(website_sale_sortable)[website.shop_default_sort]"
                    />
                </t>
            </t>
        </xpath>
    </template>
</odoo>
