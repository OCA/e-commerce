#. module: website_sale_order_type
#: model:ir.model,name:website_sale_order_type.model_res_config_settings
msgid "Config Settings"
msgstr "Impostazioni configurazione"

#. module: website_sale_order_type
#: model:ir.model.fields,help:website_sale_order_type.field_res_config_settings__sale_type_id
#: model:ir.model.fields,help:website_sale_order_type.field_website__sale_type_id
msgid ""
"If set, this sale order type is used for all orders created from this "
"website and takes precedence over the partner sale order type."
msgstr ""
"Se impostato, questo tipo di ordine di vendita viene utilizzato per tutti "
"gli ordini creati da questo sito web e ha la precedenza sul tipo di ordine "
"di vendita del partner."

