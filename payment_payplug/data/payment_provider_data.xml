<odoo noupdate="1">
    <record id="payment_provider_payplug" model="payment.provider">
        <field name="name">Payplug</field>
        <field name="code">payplug</field>
        <field
            name="image_128"
            type="base64"
            file="payment_payplug/static/description/icon.png"
        />
        <field name="module_id" ref="base.module_payment_payplug" />
        <field name="redirect_form_view_id" ref="redirect_form" />
        <field
            name="payment_method_ids"
            eval="[Command.set([
                ref('payment.payment_method_card'),
                ref('payment.payment_method_bancontact'),
                ref('payment.payment_method_ideal'),
                ref('payment.payment_method_mybank'),
            ])]"
        />
    </record>
</odoo>
