#. module: payment_payplug
#: model:ir.model.fields.selection,name:payment_payplug.selection__payment_provider__payplug_auth_method__api_key
msgid "API Key"
msgstr "Clé API"

#. module: payment_payplug
#: model:ir.model.fields,help:payment_payplug.field_payment_provider__payplug_auth_method
msgid ""
"API Key: the secret key of your Payplug account is sent with every request.\n"
"OAuth2: Odoo exchanges a client ID and secret for access tokens valid a few minutes, renewed automatically."
msgstr ""
"Clé API : la clé secrète de votre compte Payplug est envoyée à chaque requête.\n"
"OAuth2 : Odoo échange un client ID et un client secret contre des jetons d'accès valables quelques minutes, renouvelés automatiquement."

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_provider_form
msgid "Authentication"
msgstr "Authentification"

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_transaction_form
msgid "Check Status on Payplug"
msgstr "Vérifier le statut sur Payplug"

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_provider_form
msgid "Client ID"
msgstr "Client ID"

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_provider_form
msgid "Client Secret"
msgstr "Client secret"

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__code
msgid "Code"
msgstr "Code"

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "Could not reach the Payplug authorization server to get an access token. Please try again later."
msgstr "Impossible de joindre le serveur d'autorisation Payplug pour obtenir un jeton d'accès. Veuillez réessayer plus tard."

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__display_name
#: model:ir.model.fields,field_description:payment_payplug.field_payment_transaction__display_name
msgid "Display Name"
msgstr "Nom d'affichage"

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_transaction_form
msgid "Fetch the status of this transaction from Payplug and update it."
msgstr "Relit le statut de cette transaction auprès de Payplug et la met à jour."

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__id
#: model:ir.model.fields,field_description:payment_payplug.field_payment_transaction__id
msgid "ID"
msgstr "ID"

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "In test mode, the Payplug OAuth2 key must be a key of the Test environment (access token scope: %s)."
msgstr "En mode test, la clé OAuth2 Payplug doit être une clé de l'environnement Test (portée du jeton d'accès : %s)."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "In test mode, the Payplug secret key must be a test key (starting with %s)."
msgstr "En mode test, la clé secrète Payplug doit être une clé de test (commençant par %s)."

#. module: payment_payplug
#: model:ir.model.fields.selection,name:payment_payplug.selection__payment_provider__payplug_auth_method__oauth2
msgid "OAuth2"
msgstr "OAuth2"

#. module: payment_payplug
#: model:ir.model,name:payment_payplug.model_payment_provider
msgid "Payment Provider"
msgstr "Fournisseur de paiement"

#. module: payment_payplug
#: model:ir.model,name:payment_payplug.model_payment_transaction
msgid "Payment Transaction"
msgstr "Transaction de paiement"

#. module: payment_payplug
#: model:ir.model.fields.selection,name:payment_payplug.selection__payment_provider__code__payplug
#: model:payment.provider,name:payment_payplug.payment_provider_payplug
msgid "Payplug"
msgstr "Payplug"

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__payplug_auth_method
msgid "Payplug Authentication"
msgstr "Authentification Payplug"

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__payplug_client_id
msgid "Payplug Client ID"
msgstr "Client ID Payplug"

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__payplug_client_secret
msgid "Payplug Client Secret"
msgstr "Client secret Payplug"

#. module: payment_payplug
#: model:ir.model.fields,field_description:payment_payplug.field_payment_provider__payplug_secret_key
msgid "Payplug Secret Key"
msgstr "Clé secrète Payplug"

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "Payplug did not return any payment page URL."
msgstr "Payplug n'a renvoyé aucune adresse de page de paiement."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "Payplug does not accept refunds below %s."
msgstr "Payplug n'accepte pas les remboursements inférieurs à %s."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "Payplug only accepts card payments between %(minimum)s and %(maximum)s."
msgstr "Payplug n'accepte les paiements par carte qu'entre %(minimum)s et %(maximum)s."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "Payplug refused the OAuth2 client ID or secret. Check them, and check that the key belongs to the right environment (Test or Live)."
msgstr "Payplug a refusé le client ID ou le client secret OAuth2. Vérifiez-les, ainsi que l'environnement de la clé (Test ou Live)."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "Payplug refused the access token request (HTTP %(status)s %(error)s)."
msgstr "Payplug a refusé la demande de jeton d'accès (HTTP %(status)s %(error)s)."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "Payplug returned an invalid access token response."
msgstr "Payplug a renvoyé une réponse de jeton d'accès invalide."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "Payplug returned an object that is not a payment."
msgstr "Payplug a renvoyé un objet qui n'est pas un paiement."

#. module: payment_payplug
#: model_terms:ir.ui.view,arch_db:payment_payplug.payment_provider_form
msgid "Secret Key"
msgstr "Clé secrète"

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "The Payplug OAuth2 client ID and secret are not set."
msgstr "Le client ID et le client secret OAuth2 Payplug ne sont pas renseignés."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "The Payplug authorization server is unavailable (HTTP %s). Please try again later."
msgstr "Le serveur d'autorisation Payplug est indisponible (HTTP %s). Veuillez réessayer plus tard."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The Payplug payment does not reference this transaction."
msgstr "Le paiement Payplug ne fait pas référence à cette transaction."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The Payplug payment environment (test or live) does not match the provider."
msgstr "L'environnement du paiement Payplug (test ou production) ne correspond pas à celui du fournisseur."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The Payplug payment id does not match the transaction."
msgstr "L'identifiant du paiement Payplug ne correspond pas à la transaction."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The Payplug refund does not match the transaction."
msgstr "Le remboursement Payplug ne correspond pas à la transaction."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The Payplug refund environment (test or live) does not match the provider."
msgstr "L'environnement du remboursement Payplug (test ou production) ne correspond pas à celui du fournisseur."

#. module: payment_payplug
#: model:ir.model.fields,help:payment_payplug.field_payment_provider__payplug_client_id
msgid "The client ID of an OAuth2 key of your Payplug account: a key of the Test environment in test mode, a key of the Live environment when the provider is enabled."
msgstr "Le client ID d'une clé OAuth2 de votre compte Payplug : une clé de l'environnement Test en mode test, une clé de l'environnement Live quand le fournisseur est activé."

#. module: payment_payplug
#: model:ir.model.fields,help:payment_payplug.field_payment_provider__payplug_client_secret
msgid "The client secret of the OAuth2 key, shown once by the Payplug portal when the key is created."
msgstr "Le client secret de la clé OAuth2, affiché une seule fois par le portail Payplug à la création de la clé."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "The following fields must be filled: %s"
msgstr "Les champs suivants doivent être renseignés : %s"

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The payment was canceled on Payplug (%s)."
msgstr "Le paiement a été annulé chez Payplug (%s)."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_transaction.py:0
msgid "The payment was refused by Payplug (%(code)s): %(message)s"
msgstr "Le paiement a été refusé par Payplug (%(code)s) : %(message)s"

#. module: payment_payplug
#: model:ir.model.fields,help:payment_payplug.field_payment_provider__payplug_secret_key
msgid "The secret key of your Payplug account: a key of the Test environment in test mode, a key of the Live environment when the provider is enabled."
msgstr "La clé secrète de votre compte Payplug : une clé de l'environnement Test en mode test, une clé de l'environnement Live quand le fournisseur est activé."

#. module: payment_payplug
#: model:ir.model.fields,help:payment_payplug.field_payment_provider__code
msgid "The technical code of this payment provider."
msgstr "Le code technique de ce fournisseur de paiement."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "When the provider is enabled, the Payplug OAuth2 key must be a key of the Live environment (access token scope: %s)."
msgstr "Quand le fournisseur est activé, la clé OAuth2 Payplug doit être une clé de l'environnement Live (portée du jeton d'accès : %s)."

#. module: payment_payplug
#. odoo-python
#: code:addons/payment_payplug/models/payment_provider.py:0
msgid "When the provider is enabled, the Payplug secret key must be a live key (starting with %s)."
msgstr "Quand le fournisseur est activé, la clé secrète Payplug doit être une clé de production (commençant par %s)."

#. module: payment_payplug
#: model_terms:payment.provider,auth_msg:payment_payplug.payment_provider_payplug
msgid "Your payment has been authorized."
msgstr "Votre paiement a été autorisé."

#. module: payment_payplug
#: model_terms:payment.provider,cancel_msg:payment_payplug.payment_provider_payplug
msgid "Your payment has been cancelled."
msgstr "Votre paiement a été annulé."

#. module: payment_payplug
#: model_terms:payment.provider,pending_msg:payment_payplug.payment_provider_payplug
msgid "Your payment has been processed but is waiting for approval."
msgstr "Votre paiement a été traité mais est en attente d’approbation."

#. module: payment_payplug
#: model_terms:payment.provider,done_msg:payment_payplug.payment_provider_payplug
msgid "Your payment has been processed."
msgstr "Votre paiement a été traité."
