<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Payplug Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'payplug'">
                    <field
                        name="payplug_auth_method"
                        string="Authentication"
                        widget="radio"
                        required="code == 'payplug'"
                    />
                    <field
                        name="payplug_secret_key"
                        string="Secret Key"
                        invisible="payplug_auth_method == 'oauth2'"
                        required="code == 'payplug' and state != 'disabled' and payplug_auth_method != 'oauth2'"
                        password="True"
                    />
                    <field
                        name="payplug_client_id"
                        string="Client ID"
                        invisible="payplug_auth_method != 'oauth2'"
                        required="code == 'payplug' and state != 'disabled' and payplug_auth_method == 'oauth2'"
                    />
                    <field
                        name="payplug_client_secret"
                        string="Client Secret"
                        invisible="payplug_auth_method != 'oauth2'"
                        required="code == 'payplug' and state != 'disabled' and payplug_auth_method == 'oauth2'"
                        password="True"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
