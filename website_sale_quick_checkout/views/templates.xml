<odoo>
    <template id="navigation_buttons" inherit_id="website_sale.navigation_buttons">
        <!-- The main button lives inside <t t-else=""> which only renders when
             NOT on the payment step, so this shortcut shows only on the Order,
             Address and Extra Info pages without an additional t-if. -->
        <xpath expr="//a[@name='website_sale_main_button']" position="after">
            <a role="button" href="/shop/payment" class="btn btn-secondary w-100">
                Payment
            </a>
        </xpath>
    </template>
</odoo>
